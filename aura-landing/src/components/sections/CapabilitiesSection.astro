---
// src/components/sections/CapabilitiesSection.astro
const { t } = Astro.props;

const capabilities = [
    { title: t('sectionCapabilities.card1.title'), description: t('sectionCapabilities.card1.description'), icon: "git-branch", color: 12 },
    { title: t('sectionCapabilities.card2.title'), description: t('sectionCapabilities.card2.description'), icon: "zap", color: 4 },
    { title: t('sectionCapabilities.card3.title'), description: t('sectionCapabilities.card3.description'), icon: "cpu", color: 9 },
    { title: t('sectionCapabilities.card4.title'), description: t('sectionCapabilities.card4.description'), icon: "git-merge", color: 3 }
];
---
<section id="capabilities" class="relative py-24 sm:py-40 px-4 bg-transparent overflow-hidden">
    
    <!-- ===================================================================== -->
    <!-- FONDO ORGÁNICO CON "FADE" (MÁSCARA DE DESVANECIMIENTO) -->
    <!-- ===================================================================== -->
    <div class="absolute inset-0 pointer-events-none z-0"
         style="mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%); 
                -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20%, black 80%, transparent 100%);">
        
        <!-- FORMA 1: La "Llamarada" Roja/Naranja (Izquierda) 
             Movida ligeramente para que el centro brillante no toque el borde superior -->
        <div class="absolute top-[-10%] left-[-10%] w-[70%] h-[120%] 
                    bg-gradient-to-b from-[var(--neon-color-15)] via-aura-red to-transparent 
                    opacity-80 blur-[90px] rounded-[100%] rotate-[15deg] mix-blend-screen">
        </div>

        <!-- FORMA 2: El Contraste Azul/Violeta (Derecha) 
             Movida ligeramente hacia arriba para centrar el impacto -->
        <div class="absolute bottom-[-10%] right-[-10%] w-[60%] h-[90%] 
                    bg-gradient-to-t from-aura-blue via-purple-800 to-transparent 
                    opacity-90 blur-[100px] rounded-[40%] -rotate-[30deg] mix-blend-screen">
        </div>

        <!-- FORMA 3: Puente Central -->
        <div class="absolute top-[30%] left-[30%] w-[50%] h-[50%] 
                    bg-pink-600 opacity-50 blur-[120px] rounded-full mix-blend-screen">
        </div>
        
    </div>

    <!-- CONTENIDO (z-10) -->
    <div class="container mx-auto text-center relative z-10">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white drop-shadow-2xl">
            {t('sectionCapabilities.title')}
        </h2>
        <p class="max-w-3xl mx-auto text-lg md:text-xl text-white/90 mb-20 font-medium drop-shadow-lg leading-relaxed">
            {t('sectionCapabilities.subtitle')}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 text-center">
            {capabilities.map(item => (
                <div
                    class="group relative p-4"
                    style={`--glow-color: var(--neon-color-${item.color}); --glow-color-rgb: var(--neon-color-${item.color}-rgb);`}
                >
                    <div class="icon-wrapper w-20 h-20 mx-auto mb-8 rounded-full border-2 border-white/20 flex items-center justify-center bg-black/40 backdrop-blur-md transition-all duration-300 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
                        <svg class="w-8 h-8 text-white transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            {item.icon === 'zap' && <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>}
                            {item.icon === 'git-merge' && <><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M6 21V9a9 9 0 0 0 9 9h1"></path></>}
                            {item.icon === 'git-branch' && <><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></>}
                            {item.icon === 'cpu' && <><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></>}
                        </svg>
                    </div>

                    <h3 class="text-2xl font-bold mb-4 text-white drop-shadow-xl">{item.title}</h3>
                    <p class="text-white/90 font-medium drop-shadow-md text-base leading-relaxed">{item.description}</p>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
.group:hover .icon-wrapper {
    background-color: rgba(var(--glow-color-rgb), 0.3);
    border-color: var(--glow-color);
    box-shadow: 0 0 40px rgba(var(--glow-color-rgb), 0.8); /* Brillo más intenso al hover */
    transform: scale(1.15) rotate(5deg);
}
.group:hover .icon-wrapper svg {
    color: var(--glow-color);
    filter: drop-shadow(0 0 10px var(--glow-color));
}
</style>