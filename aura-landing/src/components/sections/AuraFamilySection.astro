---
// src/components/sections/AuraFamilySection.astro
const { t } = Astro.props;

const skillTypes = [
    { title: t('sectionSystem.skills.sensory.title'), description: t('sectionSystem.skills.sensory.description'), icon: "eye", color: 3 },
    { title: t('sectionSystem.skills.motor.title'), description: t('sectionSystem.skills.motor.description'), icon: "zap", color: 5 },
    { title: t('sectionSystem.skills.cognitive.title'), description: t('sectionSystem.skills.cognitive.description'), icon: "brain", color: 7 },
    { title: t('sectionSystem.skills.logical.title'), description: t('sectionSystem.skills.logical.description'), icon: "settings", color: 1 },
    { title: t('sectionSystem.skills.memory.title'), description: t('sectionSystem.skills.memory.description'), icon: "database", color: 11 }
];

const hierarchyLevels = [
    { level: t('sectionSystem.hierarchy.level1.level'), title: t('sectionSystem.hierarchy.level1.title'), description: t('sectionSystem.hierarchy.level1.description'), icon: "tool" },
    { level: t('sectionSystem.hierarchy.level2.level'), title: t('sectionSystem.hierarchy.level2.title'), description: t('sectionSystem.hierarchy.level2.description'), icon: "share-2" },
    { level: t('sectionSystem.hierarchy.level3.level'), title: t('sectionSystem.hierarchy.level3.title'), description: t('sectionSystem.hierarchy.level3.description'), icon: "sparkles" }
]
---
<section id="family" class="relative py-20 sm:py-32 px-4 bg-transparent">
    
    <!-- LUZ VOLUMÉTRICA DE FONDO (Igual que antes) -->
    <div class="absolute inset-0 pointer-events-none z-0">
        <div class="absolute top-[-10%] left-[-10%] w-[600px] h-[600px] bg-aura-blue/15 rounded-full blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-5%] w-[700px] h-[700px] bg-aura-red/10 rounded-full blur-[100px]"></div>
    </div>

    <div class="container mx-auto relative z-10">
        <!-- Título principal -->
        <div class="text-center max-w-4xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">{t('sectionSystem.title')}</h2>
            <p class="text-base md:text-lg text-muted mb-12">{t('sectionSystem.subtitle')}</p>
        </div>

        <!-- Grid de Skills (Círculos) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-20 max-w-7xl mx-auto">
            {skillTypes.map(item => (
                <div 
                    class="text-center group p-6 rounded-2xl border-2 border-transparent transition-all duration-300 backdrop-blur-sm bg-black/20"
                    style={`--glow-color: var(--neon-color-${item.color}); --glow-color-rgb: var(--neon-color-${item.color}-rgb);`}
                >
                    <div class="icon-wrapper w-16 h-16 mx-auto mb-4 rounded-full border-2 border-white/10 flex items-center justify-center bg-black/40 transition-all duration-300">
                        <svg class="w-7 h-7 text-white/60 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            {item.icon === 'eye' && <><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></>}
                            {item.icon === 'zap' && <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>}
                            {item.icon === 'brain' && <><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v1a2.5 2.5 0 0 1-2.5 2.5h-1A2.5 2.5 0 0 1 6 5.5v-1A2.5 2.5 0 0 1 8.5 2h1Z"></path><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v1a2.5 2.5 0 0 0 2.5 2.5h1A2.5 2.5 0 0 0 18 5.5v-1A2.5 2.5 0 0 0 15.5 2h-1Z"></path><path d="M6 10a2.5 2.5 0 0 1 2.5-2.5h7A2.5 2.5 0 0 1 18 10v1a2.5 2.5 0 0 1-2.5 2.5h-1a2.5 2.5 0 0 0-2.5 2.5v1a2.5 2.5 0 0 1-2.5 2.5h-1A2.5 2.5 0 0 1 6 17.5v-1a2.5 2.5 0 0 0-2.5-2.5H2.5A2.5 2.5 0 0 1 0 11.5v-1A2.5 2.5 0 0 1 2.5 8H6v2Z"></path><path d="M21.5 8a2.5 2.5 0 0 0-2.5 2.5v1a2.5 2.5 0 0 0 2.5 2.5h1a2.5 2.5 0 0 1 2.5 2.5v1a2.5 2.5 0 0 0 2.5 2.5h1a2.5 2.5 0 0 0 2.5-2.5v-1a2.5 2.5 0 0 1-2.5-2.5h-1a2.5 2.5 0 0 0-2.5-2.5V10a2.5 2.5 0 0 0-2.5-2.5h-1Z"></path></>}
                            {item.icon === 'settings' && <><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V15a1.65 1.65 0 0 0 1.51 1z"></path></>}
                            {item.icon === 'database' && <><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></>}
                        </svg>
                    </div>
                    <h3 class="font-bold text-white mb-2 text-md">{item.title}</h3>
                    <p class="text-xs text-muted">{item.description}</p>
                </div>
            ))}
        </div>
        
        <div class="text-center max-w-3xl mx-auto">
            <h3 class="text-2xl font-bold mb-4 text-white">{t('sectionSystem.hierarchy.subtitle')}</h3>
            <p class="text-base text-muted mb-16">{t('sectionSystem.hierarchy.intro')}</p>
        </div>

        <!-- ======================================================== -->
        <!--  AQUÍ ESTÁ EL CAMBIO: Tarjetas de Jerarquía Estilo Showcase -->
        <!-- ======================================================== -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {hierarchyLevels.map(item => (
                /* 
                   Usamos la clase .interactive-card que definimos en global.css
                   Esto crea el borde gradiente animado y el efecto hover.
                */
                <div class="interactive-card rounded-2xl h-full group">
                    <div class="interactive-card-content p-8 flex flex-col h-full bg-black/40 backdrop-blur-md transition-colors duration-300">
                        
                        <!-- Ícono con gradiente sutil -->
                        <div class="flex-shrink-0 w-12 h-12 mb-6 rounded-lg bg-gradient-to-br from-aura-red/80 to-aura-blue/80 flex items-center justify-center shadow-lg shadow-aura-blue/20">
                             <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                {item.icon === 'tool' && <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>}
                                {item.icon === 'share-2' && <><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></>}
                                {item.icon === 'sparkles' && <><path d="M9.912 2.012a3 3 0 0 1 4.176 0l.962.962a3 3 0 0 0 4.242 0l.962-.962a3 3 0 0 1 4.176 4.176l-.962.962a3 3 0 0 0 0 4.242l.962.962a3 3 0 0 1-4.176 4.176l-.962-.962a3 3 0 0 0-4.242 0l-.962.962a3 3 0 0 1-4.176-4.176l.962-.962a3 3 0 0 0 0-4.242l-.962-.962a3 3 0 0 1 4.176-4.176l.962.962a3 3 0 0 0 4.242 0zM12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"></path></>}
                            </svg>
                        </div>
                        
                        <div class="flex-grow">
                            <!-- Texto de nivel con gradiente -->
                            <p class="font-bold text-sm bg-clip-text text-transparent bg-gradient-to-r from-aura-red to-aura-blue mb-2 tracking-wide uppercase">
                                {item.level}
                            </p>
                            <h3 class="text-xl font-bold mb-3 text-white group-hover:text-aura-blue transition-colors duration-300">
                                {item.title}
                            </h3>
                            <p class="text-muted text-sm leading-relaxed">
                                {item.description}
                            </p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
/*
   Mantengo estos estilos para los círculos de arriba (Skills),
   pero las tarjetas de abajo ahora usan la clase global .interactive-card
*/
.group:hover {
    border-color: rgba(var(--glow-color-rgb), 0.5);
    background-color: rgba(var(--glow-color-rgb), 0.05);
}
.group:hover .icon-wrapper {
    background-color: rgba(var(--glow-color-rgb), 0.1);
    border-color: var(--glow-color);
    box-shadow: 0 0 20px rgba(var(--glow-color-rgb), 0.4);
    transform: scale(1.1);
}
.group:hover .icon-wrapper svg {
    color: var(--glow-color);
    filter: drop-shadow(0 0 8px var(--glow-color));
}
</style>