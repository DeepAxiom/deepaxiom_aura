---
// src/components/sections/ToolsSection.astro
import { githubReadmeUrl } from '../../i18n/ui.ts';
const { t } = Astro.props;

const tools = [
    { 
        title: t('sectionTools.card1.title'), 
        description: t('sectionTools.card1.description'), 
        icon: "tool", 
        color: 5 
    },
    { 
        title: t('sectionTools.card2.title'), 
        description: t('sectionTools.card2.description'), 
        icon: "edit-2", 
        color: 14 
    }
];
---
<section class="relative py-20 sm:py-32 px-4 bg-transparent">
    <!-- BACKGROUND SPOTLIGHTS (DUALIDAD CREATIVA) -->
    <div class="absolute inset-0 pointer-events-none z-0">
        <!-- Luz Izquierda Superior (Azul/Cian para Estructura/Texto) -->
        <div class="absolute top-[-100px] left-[-200px] w-[600px] h-[600px] bg-aura-blue/20 rounded-full blur-[120px] opacity-70"></div>
        
        <!-- Luz Derecha Inferior (Púrpura/Rosa para Creatividad/Tarjetas) -->
        <div class="absolute bottom-[-100px] right-[-100px] w-[600px] h-[600px] bg-[var(--neon-color-4)]/15 rounded-full blur-[120px] opacity-60"></div>
    </div>

    <div class="container mx-auto grid md:grid-cols-2 gap-16 items-center relative z-10">
        <div class="text-center md:text-left">
            <h2 class="text-4xl md:text-5xl font-bold mb-6 text-white">
                {t('sectionTools.title')}
            </h2>
            <p class="text-lg text-muted mb-10">
                {t('sectionTools.subtitle')}
            </p>
            <div class="flex justify-center md:justify-start">
                <a href={`${githubReadmeUrl}#writing-a-skill-the-sdk`} target="_blank" rel="noopener noreferrer" class="h-12 px-8 rounded-full flex items-center justify-center font-semibold text-white/80 transition-all duration-300 ease-in-out transform hover:scale-105 bg-white/5 border border-white/20 hover:bg-white/10 hover:text-white hover:shadow-[0_0_20px_rgba(255,255,255,0.2)]">
                    {t('sectionTools.button')}
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-8">
            {tools.map(item => (
                <div 
                    class="interactive-card rounded-2xl group bg-black/20 backdrop-blur-sm"
                    style={`--glow-color: var(--neon-color-${item.color}); --glow-color-rgb: var(--neon-color-${item.color}-rgb);`}
                >
                    <div class="interactive-card-content interactive-card-content-padding-small flex items-center gap-6 !bg-transparent">
                        <div class="icon-wrapper w-16 h-16 flex-shrink-0 rounded-full border-2 border-white/10 flex items-center justify-center bg-black/40 transition-all duration-300">
                           <svg class="w-7 h-7 text-white/60 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                {item.icon === 'tool' && <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>}
                                {item.icon === 'edit-2' && <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>}
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-white group-hover:text-[var(--glow-color)] transition-colors duration-300">{item.title}</h3>
                            <p class="text-muted text-sm">{item.description}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
/* El hover de la tarjeta y el del ícono se combinan */
.group:hover .icon-wrapper {
    background-color: rgba(var(--glow-color-rgb), 0.15);
    border-color: var(--glow-color);
    box-shadow: 0 0 25px rgba(var(--glow-color-rgb), 0.3);
    transform: scale(1.1);
}
.group:hover .icon-wrapper svg {
    color: var(--glow-color);
    filter: drop-shadow(0 0 8px var(--glow-color));
}
</style>