---
<section id="contact" class="relative bg-aura-dark overflow-hidden">
    
    <!-- ===================================================================== -->
    <!-- 1. EL "CIELO": Gradiente Masivo CON MÁSCARA SUPERIOR -->
    <!-- ===================================================================== -->
    <!-- 
         AGREGADO: mask-image para desvanecer la parte superior.
         Esto elimina el corte abrupto con la sección anterior.
    -->
    <div class="absolute inset-0 pointer-events-none z-0"
         style="mask-image: linear-gradient(to bottom, transparent 0%, black 25%, black 100%); 
                -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 25%, black 100%);">
        
        <!-- FORMA 1: La Gran Llamarada (Izquierda) -->
        <div class="absolute top-[-20%] left-[-15%] w-[80%] h-[120%] 
                    bg-gradient-to-b from-[var(--neon-color-15)] via-aura-red to-transparent 
                    opacity-90 blur-[100px] rounded-[100%] rotate-[15deg] mix-blend-screen">
        </div>

        <!-- FORMA 2: El Contraste Profundo (Derecha) -->
        <div class="absolute top-[10%] right-[-10%] w-[70%] h-[100%] 
                    bg-gradient-to-b from-aura-blue via-purple-800 to-transparent 
                    opacity-80 blur-[100px] rounded-[40%] -rotate-[30deg] mix-blend-screen">
        </div>

        <!-- FORMA 3: Puente Central -->
        <div class="absolute top-[20%] left-[30%] w-[50%] h-[50%] 
                    bg-pink-600 opacity-60 blur-[120px] rounded-full mix-blend-screen">
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 2. CONTENIDO PRINCIPAL: Texto y Botones (z-10) -->
    <!-- ===================================================================== -->
    <div class="container mx-auto text-center max-w-3xl relative z-10 pt-32 pb-48">
        <h2 class="text-4xl md:text-6xl font-bold text-white mb-8 drop-shadow-2xl tracking-tight">
            {t('sectionCTA.title')}
        </h2>
        <p class="text-xl text-white/95 font-medium mb-12 drop-shadow-lg leading-relaxed">
            {t('sectionCTA.subtitle')}
        </p>
        
        <!-- Botones -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="h-14 px-10 rounded-full flex items-center justify-center font-bold text-black bg-white transition-all duration-300 ease-in-out transform hover:scale-105 shadow-2xl hover:shadow-white/50">
                {t('sectionCTA.buttonPrimary')}
            </a>
            <a href="mailto:corporativo@deepaxiom.com" class="h-14 px-10 rounded-full flex items-center justify-center font-bold text-white border-2 border-white/30 hover:bg-white/10 transition-all duration-300">
                {t('sectionCTA.buttonSecondary')}
            </a>
        </div>
    </div>

    <!-- ===================================================================== -->
    <!-- 3. LA "TIERRA": Tarjeta Negra Curva (Footer Container) -->
    <!-- ===================================================================== -->
    <div class="relative z-20 w-full bg-[#020202] rounded-t-[3rem] px-4 py-16 border-t border-white/5 shadow-[0_-20px_60px_rgba(0,0,0,0.5)]">
        <div class="container mx-auto text-center">
            
            <div class="flex items-center justify-center gap-3 mb-8 opacity-70">
                <span class="w-2 h-2 rounded-full bg-aura-red animate-pulse"></span>
                <span class="text-xs font-bold tracking-[0.2em] uppercase text-white/50">Deep Axiom Status: Online</span>
            </div>

            <p class="text-sm font-bold text-white/40 uppercase tracking-widest mb-8">{t('sectionCTA.followUs')}</p>
            
            <div class="flex justify-center items-center gap-8 flex-wrap">
                {socialLinks.map(link => (
                    <a 
                        href={link.href} 
                        target="_blank" 
                        rel="noopener noreferrer" 
                        title={link.platform} 
                        class="text-white/40 hover:text-white transition-all duration-300 hover:scale-110 hover:drop-shadow-[0_0_10px_rgba(255,255,255,0.5)]"
                    >
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-label={`${link.platform} icon`}>
                            <path d={link.iconPath}></path>
                        </svg>
                    </a>
                ))}
            </div>
        </div>
    </div>
</section>