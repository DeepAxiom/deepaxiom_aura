---
// src/components/sections/ShowcaseSection.astro
import { githubDemoUrl, githubReadmeUrl } from '../../i18n/ui.ts';

const { t } = Astro.props;

const examples = [
    { id: "backoffice", tagKey: "examples.backoffice.tag", titleKey: "examples.backoffice.title", descKey: "examples.backoffice.description", linkKey: "examples.backoffice.linkText", href: githubDemoUrl, color: "aura-blue" },
    { id: "voiceloop", tagKey: "examples.voiceloop.tag", titleKey: "examples.voiceloop.title", descKey: "examples.voiceloop.description", linkKey: "examples.voiceloop.linkText", href: githubReadmeUrl, color: "aura-red" },
    { id: "legacy", tagKey: "examples.legacy.tag", titleKey: "examples.legacy.title", descKey: "examples.legacy.description", linkKey: "examples.legacy.linkText", href: githubReadmeUrl, color: "purple-400" },
    { id: "federation", tagKey: "examples.federation.tag", titleKey: "examples.federation.title", descKey: "examples.federation.description", linkKey: "examples.federation.linkText", href: githubReadmeUrl, color: "green-400" },
];
---
<section id="use-cases" class="relative py-20 sm:py-32 px-4 bg-transparent">
    <!-- LUZ VOLUMÉTRICA CRUZADA -->
    <div class="absolute inset-0 pointer-events-none z-0">
         <!-- Luz izquierda inferior (cian) -->
        <div class="absolute bottom-[-200px] left-[-200px] w-[800px] h-[800px] bg-[var(--neon-color-3)]/10 rounded-full blur-[150px]"></div>
         <!-- Luz derecha superior (roja) -->
        <div class="absolute top-[-100px] right-[-100px] w-[600px] h-[600px] bg-aura-red/15 rounded-full blur-[150px]"></div>
    </div>

    <div class="container mx-auto relative z-10">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">{t('sectionShowcase.title')}</h2>
            <p class="max-w-3xl mx-auto text-base md:text-lg text-muted">
                {t('sectionShowcase.subtitle')}
            </p>
        </div>

        <h3 class="text-xl font-bold text-white mb-6 border-l-4 border-aura-blue pl-4">
            {t('sectionShowcase.category.deployed')}
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {examples.map(item => (
                <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block interactive-card clickable-card rounded-2xl border border-white/10 h-full text-left bg-aura-dark/50 backdrop-blur-sm"
                >
                    <div class="interactive-card-content p-8 flex flex-col h-full !bg-transparent">
                        <div class="flex justify-between items-start mb-4">
                            <p class={`text-xs font-bold tracking-widest uppercase text-${item.color} mb-2`}>
                                {t(item.tagKey)}
                            </p>
                        </div>
                        <h3 class="text-xl font-bold mb-3 text-white group-hover:text-aura-blue transition-colors">
                            {t(item.titleKey)}
                        </h3>
                        <p class="text-muted text-sm leading-relaxed flex-grow">
                            {t(item.descKey)}
                        </p>
                        <div class="mt-6 flex items-center text-sm font-semibold text-white/50 group-hover:text-white transition-colors">
                            <span>{t(item.linkKey)}</span>
                            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                            </svg>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>
