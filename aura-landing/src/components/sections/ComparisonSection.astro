---
// src/components/sections/ComparisonSection.astro
import { githubUrl } from '../../i18n/ui.ts';
const { t, lang } = Astro.props;

const features = [
    {
        key: 'paradigm',
        icon: 'cpu',
        isHighlight: false
    },
    {
        key: 'devs',
        icon: 'code',
        isHighlight: true // Destacamos esto para el Marketplace
    },
    {
        key: 'users',
        icon: 'users',
        isHighlight: false
    },
    {
        key: 'execution',
        icon: 'zap',
        isHighlight: false
    }
];
---
<section class="relative py-20 sm:py-32 px-4 bg-transparent overflow-hidden">
    
    <!-- LUZ DE FONDO (Spotlights) -->
    <div class="absolute inset-0 pointer-events-none z-0">
        <!-- Luz Central Fría para separar las columnas -->
        <div class="absolute top-[20%] left-1/2 -translate-x-1/2 w-[800px] h-[800px] bg-purple-900/20 rounded-full blur-[120px]"></div>
    </div>

    <div class="container mx-auto relative z-10">
        
        <!-- HEADER -->
        <div class="text-center max-w-4xl mx-auto mb-16">
            <h2 class="text-3xl md:text-5xl font-bold mb-6 text-white drop-shadow-xl">
                {t('sectionComparison.title')}
            </h2>
            <p class="text-lg text-muted">
                {t('sectionComparison.subtitle')}
            </p>
        </div>

        <!-- GRID COMPARATIVA -->
        <!-- items-stretch asegura que ambas tarjetas tengan la misma altura -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch max-w-6xl mx-auto">
            
            <!-- TARJETA 1: MAKE / N8N (El Pasado - Estilo "Glass" Apagado) -->
            <div class="h-full bg-white/5 border border-white/10 rounded-3xl p-8 backdrop-blur-sm flex flex-col transition-transform duration-300 hover:bg-white/[0.07]">
                
                <!-- Header -->
                <div class="flex items-center gap-4 mb-8 opacity-70">
                    <div class="w-12 h-12 rounded-xl bg-white/10 flex items-center justify-center text-white/60">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white">Workflow Tools</h3>
                        <p class="text-xs text-white/40 uppercase tracking-widest">n8n / Zapier / Make</p>
                    </div>
                </div>

                <!-- Features -->
                <div class="space-y-8 flex-grow">
                    {features.map(f => (
                        <div class="border-l-2 border-white/10 pl-4 py-1">
                            <p class="text-[10px] text-white/30 uppercase tracking-widest font-bold mb-1">
                                {t(`comparison.feature.${f.key}`)}
                            </p>
                            <p class="text-white/60 text-sm leading-relaxed">
                                {t(`comparison.competitor.${f.key}`)}
                            </p>
                        </div>
                    ))}
                </div>

                <!-- Footer (Vacío visualmente para equilibrar espacio) -->
                <div class="mt-8 pt-6 border-t border-white/5 text-center">
                    <p class="text-sm text-white/20 italic">Batch Automation</p>
                </div>
            </div>

            <!-- TARJETA 2: DEEP AXIOM / AURA (El Futuro - Estilo AGRESIVO) -->
            <div class="relative h-full">
                <!-- 1. Glow Ambiental Masivo detrás de la tarjeta -->
                <div class="absolute inset-0 bg-gradient-to-br from-aura-red via-purple-600 to-aura-blue rounded-3xl blur-[20px] opacity-40 pointer-events-none"></div>
                
                <!-- 2. Borde Fino Brillante -->
                <div class="absolute -inset-[1px] bg-gradient-to-br from-aura-red via-purple-500 to-aura-blue rounded-[25px] opacity-100 pointer-events-none"></div>

                <!-- 3. Contenido de la Tarjeta -->
                <div class="relative h-full bg-black/90 rounded-3xl p-8 flex flex-col shadow-2xl overflow-hidden backdrop-blur-xl">
                    
                    <!-- Header -->
                    <div class="flex items-center justify-between mb-8">
                        <div class="flex items-center gap-4">
                             <!-- Logo AURA con Gradiente -->
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-r from-aura-red to-aura-blue flex items-center justify-center shadow-lg shadow-purple-500/30 text-white">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white tracking-wide">Deep Axiom</h3>
                                <p class="text-xs text-aura-blue uppercase tracking-widest font-bold">AURA Kernel</p>
                            </div>
                        </div>
                        <!-- Badge "Open Source" -->
                        <span class="px-3 py-1 rounded-full bg-aura-blue/20 border border-aura-blue/50 text-aura-blue text-[10px] font-bold uppercase animate-pulse shadow-[0_0_10px_rgba(0,121,251,0.3)]">
                            Open Source
                        </span>
                    </div>

                    <!-- Features (Con los bordes de colores agresivos) -->
                    <div class="space-y-6 flex-grow">
                        {features.map(f => (
                            <div class={`pl-4 py-3 rounded-r-xl transition-all duration-300 ${f.isHighlight ? 'bg-gradient-to-r from-aura-blue/10 to-transparent border-l-4 border-aura-blue shadow-[inset_10px_0_20px_-10px_rgba(0,121,251,0.3)]' : 'border-l-4 border-aura-red hover:bg-white/5'}`}>
                                <p class="text-[10px] text-white/50 uppercase tracking-widest font-bold mb-1 flex items-center gap-2">
                                    {t(`comparison.feature.${f.key}`)}
                                    {f.isHighlight && <span class="text-yellow-400 text-[10px] drop-shadow-[0_0_5px_rgba(250,204,21,0.5)]">★ KEY</span>}
                                </p>
                                <p class={`text-sm leading-relaxed ${f.isHighlight ? 'text-white font-bold text-base' : 'text-white/90 font-medium'}`}>
                                    {t(`comparison.deepaxiom.${f.key}`)}
                                </p>
                            </div>
                        ))}
                    </div>
                    
                    <!-- Call to Action -->
                    <div class="mt-8 pt-6 border-t border-white/10 text-center">
                        <p class="text-xs text-muted mb-4 font-mono">Clone it. Build it. Run it.</p>
                        <!-- Botón con Gradiente Sutil -->
                        <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="group relative flex items-center justify-center w-full py-4 rounded-xl bg-white/5 border border-white/10 hover:border-aura-blue/50 transition-all duration-300 overflow-hidden">
                            <div class="absolute inset-0 bg-gradient-to-r from-aura-red/20 via-transparent to-aura-blue/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                            <span class="relative font-bold text-white tracking-wide flex items-center gap-2 group-hover:text-aura-blue transition-colors">
                                View on GitHub
                                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                            </span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>