---
// src/components/Header.astro
import { ui, defaultLang, githubUrl } from '../i18n/ui';

const { pathname } = Astro.url;
const lang = pathname.split('/')[1] as keyof typeof ui || defaultLang;
const t = ui[lang] || ui[defaultLang];

const headerLinks = [
    { href: `/${lang}/#family`,       labelKey: 'header.family',       icon: 'hierarchy',    color: 1, external: false },
    { href: `/${lang}/#capabilities`, labelKey: 'header.capabilities', icon: 'sliders',      color: 3, external: false },
    { href: `/${lang}/#axioms`,       labelKey: 'header.axioms',       icon: 'shield-check', color: 4, external: false },
    { href: `/${lang}/#use-cases`,    labelKey: 'header.useCases',     icon: 'briefcase',    color: 5, external: false },
    { href: `/${lang}/docs`,         labelKey: 'header.docs',         icon: 'file-text',    color: 6, external: false },
    { href: `/${lang}/blog`,          labelKey: 'header.blog',         icon: 'book',         color: 2, external: false }, // Link a página
    { href: githubUrl,                labelKey: 'header.github',       icon: 'github',       color: 8, external: true },
    { href: `/${lang}/#contact`,      labelKey: 'header.contact',      icon: 'mail',         color: 7, external: false },
];
---

<header class="fixed top-6 left-0 w-full z-50 flex justify-center pointer-events-none">

    <div class="pointer-events-auto flex items-center backdrop-blur-xl bg-black/40 border border-white/10 rounded-full shadow-2xl px-2 py-2 transition-all duration-300 hover:bg-black/60 hover:border-white/20">
        
        <a href={`/${lang}/`} class="pl-4 pr-4 border-r border-white/10 flex items-center group" aria-label="Homepage">
            <img src="/logo.svg" alt="Deep Axiom" class="h-6 w-auto opacity-80 group-hover:opacity-100 transition-opacity" />
        </a>
        
        <ul class="flex items-center gap-1 pl-2">
            {headerLinks.map(link => {
                const neonColorVar = `--neon-color-${link.color}`;
                const neonColorRgbVar = `--neon-color-${link.color}-rgb`;
                

                const isActive = link.href.includes('/blog') && pathname.includes('/blog');

                return (
                    <li>
                        <a
                            href={link.href}
                            target={link.external ? '_blank' : undefined}
                            rel={link.external ? 'noopener noreferrer' : undefined}
                            class={`
                                relative flex items-center h-10 px-3 rounded-full transition-all duration-500 ease-out group overflow-hidden
                                ${isActive ? 'bg-white/10 text-white shadow-[0_0_15px_rgba(var(--glow-color-rgb),0.3)]' : 'text-white/60 hover:text-white hover:bg-white/5'}
                            `}
                            style={`--glow-color: var(${neonColorVar}); --glow-color-rgb: var(${neonColorRgbVar});`}
                        >
                            <div class="flex items-center justify-center w-6 h-6 z-10 transition-transform duration-300 group-hover:scale-110 group-hover:text-[var(--glow-color)]">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    {link.icon === 'hierarchy' && <><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></>}
                                    {link.icon === 'sliders' && <><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></>}
                                    {link.icon === 'shield-check' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></>}
                                    {link.icon === 'briefcase' && <><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></>}
                                    {link.icon === 'file-text' && <><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></>}
                                    {link.icon === 'book' && <><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></>}
                                    {link.icon === 'github' && <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>}
                                    {link.icon === 'mail' && <><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></>}
                                </svg>
                            </div>


                            <span class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 group-hover:max-w-[140px] group-hover:opacity-100 group-hover:ml-3 transition-all duration-500 ease-out text-sm font-medium tracking-wide">
                                {t[link.labelKey]}
                            </span>
                            
                            <div class="absolute inset-0 rounded-full bg-[var(--glow-color)] opacity-0 group-hover:opacity-10 blur-md transition-opacity duration-300"></div>
                        </a>
                    </li>
                )
            })}
        </ul>
    </div>
</header>