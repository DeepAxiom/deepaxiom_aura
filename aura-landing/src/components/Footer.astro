---
// src/components/Footer.astro
import { ui, defaultLang } from '../i18n/ui';

const { pathname } = Astro.url;
const lang = pathname.split('/')[1] as keyof typeof ui || defaultLang;
const t = ui[lang] || ui[defaultLang];

const footerLinks = [
    { href: `/${lang}/about`, labelKey: 'footer.about' },
    { href: `/${lang}/privacy`, labelKey: 'footer.privacy' },
    { href: `/${lang}/terms`, labelKey: 'footer.terms' },
];
---
<footer class="fixed bottom-0 left-0 w-full z-40 p-6 flex justify-center items-center overflow-hidden">
    <!-- BASE DE LUZ -->
    <div class="absolute bottom-[-60px] left-1/2 -translate-x-1/2 w-[70%] h-[120px] bg-white/5 blur-[60px] rounded-full pointer-events-none -z-10"></div>

    <nav class="flex gap-6 md:gap-8 relative z-10">
        {footerLinks.map(link => (
            <a 
                href={link.href} 
                class="text-xs font-semibold uppercase tracking-wider text-white/50 hover:text-white transition-all duration-300"
            >
                {t[link.labelKey]}
            </a>
        ))}
    </nav>
</footer>

<style>
  a:hover {
    color: var(--accent-primary);
    text-shadow: 0 0 8px var(--accent-primary);
  }
</style>