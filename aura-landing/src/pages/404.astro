---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404: Lost in the Void" description="Page not found">
    <main class="h-screen flex flex-col items-center justify-center bg-aura-dark text-center px-4">
        <h1 class="text-9xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-aura-red to-aura-blue mb-4">404</h1>
        <p class="text-2xl text-white mb-8">Ruta no resuelta.</p>
        <p class="text-muted mb-8">El skill o la página que buscas no responde o no existe.</p>
        <a href="/" class="px-8 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white transition-all">
            Reiniciar Sistema (Ir al Inicio)
        </a>
    </main>
</Layout>