---
// src/pages/[lang]/index.astro
import { ui, defaultLang, languages } from '../../i18n/ui';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const translations = ui[lang] || ui[defaultLang];

const t = (key) => translations[key];

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import HeroOrbSection from '../../components/sections/HeroOrbSection.astro';
import ComparisonSection from '../../components/sections/ComparisonSection.astro';
import AuraFamilySection from '../../components/sections/AuraFamilySection.astro';
import CapabilitiesSection from '../../components/sections/CapabilitiesSection.astro';
import ShowcaseSection from '../../components/sections/ShowcaseSection.astro';
import ToolsSection from '../../components/sections/ToolsSection.astro';
import SafetySection from '../../components/sections/SafetySection.astro';
import AxiomsSection from '../../components/sections/AxiomsSection.astro';
import CTASection from '../../components/sections/CTAsection.astro';
---

<Layout title={t('seo.home.title')} description={t('seo.home.description')}>
  <Header />
  <main>
    <HeroOrbSection t={t} lang={lang} />

    <ComparisonSection t={t} lang={lang} />

    <AuraFamilySection t={t} />

    <CapabilitiesSection t={t} />

    <ShowcaseSection t={t} lang={lang} />

    <ToolsSection t={t} lang={lang} />

    <SafetySection t={t} />

    <AxiomsSection t={t} />

    <CTASection t={t} lang={lang} />
  </main>
</Layout>