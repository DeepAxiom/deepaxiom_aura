---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { ui, defaultLang, languages } from '../../i18n/ui';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const translations = ui[lang] || ui[defaultLang];
const t = (key) => translations[key];
---
<Layout title={t('seo.about.title')} description={t('seo.about.description')}>
  <Header />
  <main class="pt-24 pb-24">
    <section id="about" class="py-20 sm:py-32 px-4">
      <div class="container mx-auto max-w-3xl text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">{t('about.title')}</h1>
        <p class="text-xl text-muted mb-16">{t('about.intro')}</p>

        <div class="space-y-12 text-left bg-white/5 border border-white/10 rounded-xl p-8 md:p-12">
          <div>
            <h2 class="text-2xl font-bold text-aura-red mb-3">{t('about.product.title')}</h2>
            <p class="text-muted">{t('about.product.text')}</p>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-aura-red mb-3">{t('about.mission.title')}</h2>
            <p class="text-muted">{t('about.mission.text')}</p>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-aura-red mb-3">{t('about.vision.title')}</h2>
            <p class="text-muted">{t('about.vision.text')}</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>