---
// src/pages/[lang]/blog/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { ui, defaultLang, languages } from '../../../i18n/ui';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const translations = ui[lang] || ui[defaultLang];
const t = (key) => translations[key];

const allPosts = await getCollection('blog');
const posts = allPosts
    .filter((post) => post.slug.startsWith(`${lang}/`))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Deep Axiom Blog | Axiom Log" description="Insights from the Deep Axiom engineering team.">
    <Header />
    <main class="pt-32 pb-24 bg-aura-dark min-h-screen">
        <div class="container mx-auto px-4">
            
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <span class="text-sm font-bold tracking-[0.3em] text-aura-red uppercase mb-4 block">Axiom Log</span>
                <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">Transmisiones</h1>
                <p class="text-xl text-muted">
                    Ingeniería, filosofía y actualizaciones desde el borde de la inteligencia artificial.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {posts.map((post) => {
                    const cleanSlug = post.slug.split('/')[1];
                    
                    return (
                        <a href={`/${lang}/blog/${cleanSlug}`} class="group interactive-card rounded-2xl bg-white/5 border border-white/10 h-full flex flex-col">
                            <div class="interactive-card-content !bg-transparent flex flex-col h-full p-6">
                                
                                <div class="mb-4">
                                    <span class="text-xs text-aura-blue font-bold uppercase tracking-wider">
                                        {post.data.pubDate.toLocaleDateString(lang === 'es' ? 'es-MX' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                                    </span>
                                </div>
                                
                                <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-aura-blue transition-colors">
                                    {post.data.title}
                                </h2>
                                
                                <p class="text-muted text-sm line-clamp-3 mb-6 flex-grow">
                                    {post.data.description}
                                </p>

                                <div class="flex items-center text-sm font-semibold text-white/50 group-hover:text-white transition-colors mt-auto">
                                    <span>Leer Transmisión</span>
                                    <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                </div>
                            </div>
                        </a>
                    );
                })}
            </div>

            {posts.length === 0 && (
                <div class="text-center py-20 border border-dashed border-white/10 rounded-2xl">
                    <p class="text-muted">No hay transmisiones disponibles en este momento.</p>
                </div>
            )}
        </div>
    </main>
</Layout>