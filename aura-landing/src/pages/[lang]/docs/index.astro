---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import { ui, defaultLang, languages, githubUrl, githubReadmeUrl, githubGettingStartedUrl, githubGettingStartedEsUrl, githubLicenseUrl } from '../../../i18n/ui';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const translations = ui[lang] || ui[defaultLang];
const t = (key) => translations[key];

const gettingStartedUrl = lang === 'es' ? githubGettingStartedEsUrl : githubGettingStartedUrl;

const cliCommands = [
    { cmd: 'aura up', descKey: 'docs.cli.up' },
    { cmd: 'aura chat', descKey: 'docs.cli.chat' },
    { cmd: 'aura do', descKey: 'docs.cli.do' },
    { cmd: 'aura connect', descKey: 'docs.cli.connect' },
    { cmd: 'aura publish', descKey: 'docs.cli.publish' },
    { cmd: 'aura why', descKey: 'docs.cli.why' },
    { cmd: 'aura federate', descKey: 'docs.cli.federate' },
];
---

<Layout title={t('seo.docs.title')} description={t('seo.docs.description')}>
    <Header />
    <main class="pt-32 pb-24 px-4">
        <div class="container mx-auto max-w-4xl">

            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">{t('docs.hero.title')}</h1>
            <p class="text-lg text-muted mb-16 max-w-2xl">{t('docs.hero.subtitle')}</p>

            <section class="mb-16 bg-white/5 border border-white/10 rounded-xl p-8">
                <h2 class="text-2xl font-bold text-aura-red mb-3">{t('docs.requirements.title')}</h2>
                <p class="text-muted leading-relaxed">{t('docs.requirements.text')}</p>
            </section>

            <section class="mb-16">
                <h2 class="text-2xl font-bold text-white mb-6">{t('docs.quickstart.title')}</h2>
                <ol class="space-y-4">
                    {[t('docs.quickstart.step1'), t('docs.quickstart.step2'), t('docs.quickstart.step3'), t('docs.quickstart.step4')].map((step, i) => (
                        <li class="flex gap-4 items-start bg-black/20 border border-white/10 rounded-lg p-4">
                            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-gradient-to-br from-aura-red to-aura-blue flex items-center justify-center text-xs font-bold text-white">{i + 1}</span>
                            <span class="text-muted text-sm leading-relaxed font-mono">{step}</span>
                        </li>
                    ))}
                </ol>
            </section>

            <section class="mb-16">
                <h2 class="text-2xl font-bold text-white mb-6">{t('docs.cli.title')}</h2>
                <div class="border border-white/10 rounded-xl overflow-hidden">
                    <table class="w-full text-left">
                        <tbody>
                            {cliCommands.map((row, i) => (
                                <tr class={i % 2 === 0 ? 'bg-white/5' : 'bg-transparent'}>
                                    <td class="p-4 font-mono text-aura-blue text-sm whitespace-nowrap align-top">{row.cmd}</td>
                                    <td class="p-4 text-muted text-sm">{t(row.descKey)}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="bg-white/5 border border-white/10 rounded-xl p-8">
                <h2 class="text-2xl font-bold text-white mb-3">{t('docs.full.title')}</h2>
                <p class="text-muted leading-relaxed mb-6">{t('docs.full.text')}</p>
                <div class="flex flex-wrap gap-4">
                    <a href={githubReadmeUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center h-11 px-6 rounded-full font-semibold text-white bg-white/10 border border-white/20 hover:bg-white/20 transition-all">
                        {t('docs.full.readme')}
                    </a>
                    <a href={gettingStartedUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center h-11 px-6 rounded-full font-semibold text-white bg-white/10 border border-white/20 hover:bg-white/20 transition-all">
                        {t('docs.full.gettingstarted')}
                    </a>
                    <a href={githubLicenseUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center h-11 px-6 rounded-full font-semibold text-white bg-white/10 border border-white/20 hover:bg-white/20 transition-all">
                        {t('docs.full.license')}
                    </a>
                    <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center h-11 px-6 rounded-full font-bold text-black bg-white hover:bg-gray-200 transition-all">
                        GitHub ↗
                    </a>
                </div>
            </section>

        </div>
    </main>
</Layout>
