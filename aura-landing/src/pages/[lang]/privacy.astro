---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { ui, defaultLang, languages } from '../../i18n/ui';

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang = defaultLang } = Astro.params;
const translations = ui[lang] || ui[defaultLang];
const t = (key) => translations[key];
---
<Layout title={t('seo.privacy.title')} description={t('privacy.p1')}>
  <Header />
  <main class="pt-24 pb-24">
    <section id="privacy" class="py-20 px-4">
      <div class="container mx-auto max-w-3xl">
        <h1 class="text-4xl font-bold text-white mb-4">{t('privacy.title')}</h1>
        <p class="text-sm text-muted mb-10">{t('privacy.lastUpdated')}</p>

        <div class="prose prose-invert max-w-none text-muted">
          <p>{t('privacy.p1')}</p>
          <p>{t('privacy.p2')}</p>
          <!-- Agrega más contenido de política de privacidad aquí -->
        </div>
      </div>
    </section>
  </main>
</Layout>
<style>
  .prose p {
    margin-bottom: 1.25em;
  }
</style>