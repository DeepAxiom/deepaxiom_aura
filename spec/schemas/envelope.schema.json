{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura:spec:envelope@1",
  "title": "C3 Channel Envelope",
  "type": "object",
  "required": ["v", "id", "kind"],
  "properties": {
    "v": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "cause_id": { "type": "string" },
    "session": { "type": "string" },
    "node": { "type": "string" },
    "port": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "idem": { "type": "string" },
    "schema": { "type": "string" },
    "kind": { "enum": ["data", "done", "error", "status", "register", "confirm_request", "confirm_response", "cancel", "config_update"] },
    "payload": {},
    "receipt": { "type": "string", "description": "C4: hash of the ledger entry that sealed this effect. Present only on an envelope delivered into a motor.* skill." },
    "attest": {
      "type": "object",
      "description": "C5: what the emitting skill asserts about how it produced this payload. An assertion bound to the effects it causes, not proof of what executed — see spec/c5-attestation.md.",
      "required": ["engine", "model"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "engine_version": { "type": "string" },
        "model": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string" },
        "model_file": { "type": "string" },
        "model_sha256": { "type": "string" },
        "quantization": { "type": "string" },
        "params": { "type": "object" },
        "prompt_sha256": { "type": "string" },
        "output_sha256": { "type": "string" },
        "energy": {
          "type": "object",
          "required": ["millijoules", "source"],
          "properties": {
            "millijoules": { "type": "number", "minimum": 0 },
            "source": { "enum": ["nvml", "rapl", "powermetrics", "estimated"] },
            "basis": { "type": "string" }
          }
        },
        "tee": {},
        "usage": {
          "type": "object",
          "description": "C5 v1.2: what the engine counted for this inference. Reported by the engine, never estimated by the skill.",
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cached_input_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "trace": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
      "description": "C3 v1.7: a W3C Trace Context traceparent. Supplied by a client on the envelope that starts a chain; carried by the kernel on every hop of that chain."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "data" } } },
      "then": { "required": ["session", "node", "port", "seq", "idem", "schema", "payload"] }
    }
  ]
}
